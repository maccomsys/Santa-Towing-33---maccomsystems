                    "_id": "bwfq01",
                    "category": "Body Works",
                    "q": "Can you match my car's exact factory paint color?",
                    "a": "Yes. We use your vehicle's factory paint code combined with digital spectrophotometer scanning to mix an exact shade match, accounting even for subtle sun fade."
                  },
                  {
                    "_id": "bwfq02",
                    "category": "Body Works",
                    "q": "How long does a full-body respray or collision repair take?",
                    "a": "Single panel scuff/dent repairs take 2 to 3 days. Full showroom resprays or multi-panel collision jobs typically require 7 to 14 working days including oven curing and final machine polishing."
                  },
                  {
                    "_id": "bwfq03",
                    "category": "Body Works",
                    "q": "Do you work with insurance companies for accident repairs?",
                    "a": "Yes. Bring your comprehensive insurance claim inspection or let our service advisors generate an itemized pro forma repair estimate for your insurer's approval."
                  },
                  {
                    "_id": "bwfq04",
                    "category": "Body Works",
                    "q": "Do you provide a warranty on paintwork?",
                    "a": "Yes. All oven-baked spray finishes carry a workmanship warranty against peeling, blistering, or premature gloss fading under normal driving conditions."
                  }
                ]
