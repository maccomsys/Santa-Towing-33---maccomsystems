                "custom_faqs": [
                  {
                    "_id": "hlfq01",
                    "category": "Haulage",
                    "q": "What maximum tonnage can Santa Towing haul?",
                    "a": "Our multi-axle heavy-duty lowbed trailers and prime movers accommodate payloads ranging from 20 tons up to 100+ tons for oversized mining and construction plant machinery."
                  },
                  {
                    "_id": "hlfq02",
                    "category": "Haulage",
                    "q": "Do you handle direct container haulage out of Tema Harbour?",
                    "a": "Yes. Our drivers and container chassis trucks possess full MPS Terminal 3 and Tema Port access credentials for rapid clearance and delivery to warehouses across Greater Accra, Kumasi, and nationwide."
                  },
                  {
                    "_id": "hlfq03",
                    "category": "Haulage",
                    "q": "Is cargo insured during heavy haulage transport?",
                    "a": "Yes. All consignments are backed by comprehensive Goods-In-Transit insurance, pre-load photographic condition verification, and heavy-duty certified chain/strap lashing."
                  },
                  {
                    "_id": "hlfq04",
                    "category": "Haulage",
                    "q": "How fast can you mobilize a lowbed trailer for breakdown or site relocation?",
                    "a": "Within Greater Accra and Tema corridors, we mobilize standby lowbeds and flatbeds within 1 to 3 hours for urgent relocations and within 24 hours for pre-scheduled cross-country mining/industrial moves."
                  },
                  {
                    "_id": "hlfq05",
                    "category": "Haulage",
                    "q": "Do you provide pilot escort vehicles for oversized loads?",
                    "a": "Yes. We coordinate high-visibility escort vehicles and route hazard clearance for extra-wide earthmoving machinery and industrial transformers."
                  }
                ]
              }
            }
          ]
        }
      ]
